# ============================================================
# 静态门户部署参数模板（不含真实密钥；真实 .env 只放服务器且被 gitignore）
#   cp deploy/docker/.env.example deploy/docker/.env
# ============================================================

# ---------- 镜像 ----------
REGISTRY=ghcr.io
PORTAL_REPO=danburen/nitrowater-static
DOCS_REPO=danburen/nitrowater-plugin-docs
TOOLS_REPO=danburen/nitrowater/tools
# 三个包独立发版；留 latest 即可，回滚时填对应 sha tag
PORTAL_TAG=latest
DOCS_TAG=latest
TOOLS_TAG=latest

# ---------- 域名（DNS A 记录指向服务器）----------
# 默认用独立子域，避免与主栈 nitrowater.cn 冲突；要当主入口时改成 nitrowater.cn
PORTAL_DOMAIN=static.nitrowater.cn
DOCS_DOMAIN=docs.nitrowater.cn
TOOLS_DOMAIN=tools.nitrowater.cn
# 启用 edge profile（acme）时必填，Let's Encrypt 到期通知邮箱
SSL_EMAIL=you@example.com

# ---------- 本地预览绑定（仅公网反代时不需要改）----------
PORTAL_BIND=127.0.0.1
PORTAL_PORT=18080
DOCS_BIND=127.0.0.1
DOCS_PORT=18081
TOOLS_BIND=127.0.0.1
TOOLS_PORT=18082

# ---------- 门户镜像构建期变量（compose 用已构建镜像，改这里需重新构建）----------
# 也可在 GitHub 仓库 Variables 里配同名变量，由 build/pages workflow 注入。
VITE_DOCS_URL=https://docs.nitrowater.cn/velochatx/
VITE_TOOLS_URL=https://tools.nitrowater.cn/
VITE_GITHUB_URL=https://github.com/danburen/nitrowater
# 备案号：填入后页脚右侧显示并链接到 beian.miit.gov.cn；留空则整条隐藏
VITE_BEIAN_NO=
