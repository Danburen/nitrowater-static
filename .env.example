# 本地开发 / 本地构建模板 —— 复制为 .env.local 后按需填写。
# Vite 会自动读取 .env.local；该文件已被 .gitignore / .dockerignore 排除，
# 不会提交、也不会进入 Docker 镜像。
#
# 生产镜像由 GitHub Actions 的仓库 Variables 注入同名变量（见 deploy/README.md 第 5 节），
# 这里只供本地预览使用。注意 docker build 不会读取 .env*，需要显式 --build-arg。

VITE_DOCS_URL=https://docs.nitrowater.cn/plugin/velochatx/
VITE_TOOLS_URL=https://tools.nitrowater.cn/
VITE_GITHUB_URL=https://github.com/danburen/nitrowater
VITE_GITHUB_PROFILE_URL=https://github.com/Danburen
VITE_STATIC_REPO_URL=https://github.com/Danburen/nitrowater-static

# ICP 备案号：填入后页脚显示并链接到 beian.miit.gov.cn；留空隐藏
VITE_BEIAN_NO=
# 公安备案号：填入后页脚显示；留空隐藏
VITE_GONGAN_NO=
# 公安备案查询 URL：可留空，会自动拼 https://beian.mps.gov.cn/#/query/webSearch?code=<号码>
VITE_GONGAN_URL=
